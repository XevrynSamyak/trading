{
  "name": "solana-arb-bot",
  "version": "0.2.0",
  "private": true,
  "description": "Small self-accounting Solana DEX arbitrage bot (paper mode by default). Written in Python; these scripts are shortcuts for `python3 -m arbbot <command>`.",
  "scripts": {
    "start": "python3 -m arbbot start",
    "paper": "python3 -m arbbot paper",
    "micro": "python3 -m arbbot micro",
    "check": "python3 -m arbbot check",
    "status": "python3 -m arbbot status",
    "watch": "python3 -m arbbot watch",
    "stop-trading": "python3 -m arbbot stop-trading",
    "enable-trading": "python3 -m arbbot enable-trading",
    "report": "python3 -m arbbot report",
    "benchmark": "python3 -m arbbot benchmark",
    "backtest": "python3 -m arbbot backtest",
    "test": "python3 -m pytest -q tests"
  }
}
