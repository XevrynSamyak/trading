# --- Mode -----------------------------------------------------------------
# paper = nothing is ever signed or sent (default)
# micro = REAL tiny trades (MICRO_MAX_TRADE_USD each) to prove execution
# live  = adaptive size; refused unless MICRO results pass the go-live gate
# micro/live also need LIVE_TRADING_CONFIRM=yes and PRIVATE_SIGNING_KEY.
MODE=paper
LIVE_TRADING_CONFIRM=no

# --- Wallet -------------------------------------------------------------
# PUBLIC address of your fresh, funded bot wallet (about 44 characters).
# In paper mode the bot simulates every trade on-chain with it; nothing is
# sent and no secret is needed.
WALLET_PUBLIC_KEY=
# MICRO/LIVE only: base58 SECRET key of that same wallet. Never a seed phrase.
# Never use your main wallet. Never put bank or card details anywhere in here.
PRIVATE_SIGNING_KEY=
MICRO_MAX_TRADE_USD=5

# How real trades are sent. jito = single-transaction bundles that Jito documents
# as revert-protected (a failing transaction is dropped, tip only paid if it lands).
SEND_VIA=jito
JITO_TIP_LAMPORTS=10000

# --- Endpoints ----------------------------------------------------------
# Free Helius key (helius.dev) is much more reliable than the public RPC:
#   RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Keep the real key only in .env (git-ignored), never in the repo.
RPC_URL=https://api.mainnet-beta.solana.com

# Free Jupiter API key (Jupiter developer portal): 60 price requests/min
# instead of 30, so the bot scans about twice as fast (~8/min instead of ~4).
# With a key the bot uses api.jup.ag; without one, lite-api.jup.ag.
JUPITER_API_KEY=
# Only if you upgrade Jupiter's plan: its requests/min (default 30, or 60 with a key).
#JUPITER_RPM=60

# --- Money --------------------------------------------------------------
STARTING_BALANCE_USD=25
# Bot stops for good if the wallet falls to this (LOSS_FLOOR_USD), or to
# LOSS_FLOOR_PCT of the start (default 0.7 = 70%).
LOSS_FLOOR_PCT=0.7
DAILY_LOSS_LIMIT_USD=2
# Share of USDC used per trade. Trades grow as the wallet grows (compounding).
TRADE_SIZE_PCT=0.8
# Optional per-trade ceiling in USD. 0 = no ceiling, no profit cap.
MAX_TRADE_USD=0
# Starting profit threshold after fees; the brain tunes it from here.
MIN_PROFIT_BPS=20
# Leave empty for the default (1000 with Jito, 10000 with rpc).
PRIORITY_FEE_LAMPORTS=

# --- Bills it must earn back each month (USD) ---------------------------
# Running on an Android phone (deploy/ANDROID.md) + free Helius RPC = $0.
# Add electricity if you want to be strict, e.g. server:0,rpc:0,power:1
MONTHLY_COSTS_USD=server:0,rpc:0
# Retire after this many months in a row of not covering the bills (0 = never)
SUSTAIN_STOP_AFTER_MONTHS=2

# --- Alerts (optional) --------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Brain ----------------------------------------------------------------
# Let it find extra busy, verified tokens by itself (on/off), up to MAX_TOKENS.
TOKEN_DISCOVERY=on
MAX_TOKENS=12
MIN_TOKEN_LIQUIDITY_USD=1000000
# Base time between scans. The brain goes faster near gaps / on sudden moves
# (focus scans of a single token, ~every 2s with a key), but never faster than
# Jupiter's request limit allows, and slows down if told "too many requests".
SCAN_INTERVAL_MS=5000
DATA_DIR=./data
