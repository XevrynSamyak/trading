# --- Mode -----------------------------------------------------------------
# paper = nothing is ever signed or sent (default)
# micro = REAL tiny trades (MICRO_MAX_TRADE_USD each) to prove execution
# live  = adaptive size; refused unless MICRO results pass the go-live gate
# micro/live also need LIVE_TRADING_CONFIRM=yes and PRIVATE_SIGNING_KEY.
MODE=paper
LIVE_TRADING_CONFIRM=no

# --- Wallet -------------------------------------------------------------
# PUBLIC address of your fresh, funded bot wallet (about 44 characters).
# In paper mode the bot simulates every trade on-chain with it; nothing is
# sent and no secret is needed.
WALLET_PUBLIC_KEY=
# MICRO/LIVE only: base58 SECRET key of that same wallet. Never a seed phrase.
# Never use your main wallet. Never put bank or card details anywhere in here.
PRIVATE_SIGNING_KEY=
MICRO_MAX_TRADE_USD=5

# How real trades are sent. jito = single-transaction bundles that Jito documents
# as revert-protected (a failing transaction is dropped, tip only paid if it lands).
SEND_VIA=jito
# The tip is a share of each trade's expected profit, between a minimum and maximum.
JITO_TIP_LAMPORTS=1000
#JITO_MAX_TIP_LAMPORTS=2000000
#JITO_TIP_SHARE=0.25

# --- Endpoints ----------------------------------------------------------
# Free Helius key (helius.dev) is much more reliable than the public RPC:
#   RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Keep the real key only in .env (git-ignored), never in the repo.
RPC_URL=https://api.mainnet-beta.solana.com

# Free Jupiter API key (Jupiter developer portal): 60 price requests/min
# instead of 30, so the bot scans about twice as fast (~8/min instead of ~4).
# With a key the bot uses api.jup.ag; without one, lite-api.jup.ag.
JUPITER_API_KEY=
# Only if you upgrade Jupiter's plan: its requests/min (default 30, or 60 with a key).
#JUPITER_RPM=60

# --- Money --------------------------------------------------------------
STARTING_BALANCE_USD=25
# Bot stops for good if the wallet falls to this (LOSS_FLOOR_USD), or to
# LOSS_FLOOR_PCT of the start (default 0.7 = 70%).
LOSS_FLOOR_PCT=0.7
DAILY_LOSS_LIMIT_USD=2
# Most of the USDC one trade may use (older name: TRADE_SIZE_PCT). Trades grow
# as the wallet grows; the size ladder picks the best size up to this.
MAX_EXPOSURE_PCT=0.8
# Optional per-trade ceiling in USD. 0 = no ceiling, no profit cap.
MAX_TRADE_USD=0
# Starting profit threshold after fees; the brain tunes it from here.
MIN_PROFIT_BPS=20
# Leave empty for the default (1000 with Jito, 10000 with rpc).
PRIORITY_FEE_LAMPORTS=

# --- Decisions (defaults shown) -----------------------------------------
# Act only when expected value (net after all costs x learned chance of
# success) is at least this, and price impact is at most this.
#MIN_EXPECTED_PROFIT_USD=0.001
#MAX_PRICE_IMPACT_BPS=100
# Sizes compared on each candidate, using only request budget free right now.
#SIZE_LADDER_USD=10,25,50,100,250,500,750,1000,1500,2000,3000,5000
#MAX_LADDER_POINTS=4
# Extra margin before calling a trade profitable, and the slippage cap.
#SAFETY_BUFFER_BPS=3
#SAFETY_BUFFER_USD=0.001
#MAX_SLIPPAGE_BPS=100

# --- Risk (defaults shown) ------------------------------------------------
#MAX_CONSECUTIVE_FAILURES=5
#MAX_CONSECUTIVE_LOSSES=3
# A real trade losing more than this, or one whose landing can't be confirmed
# within LANDING_TIMEOUT_MS, disables trading until: npm run enable-trading
#UNEXPECTED_LOSS_USD=0.05
#LANDING_TIMEOUT_MS=120000
# Go-live gate: what paper must show before MICRO is recommended, and what
# MICRO must show before LIVE may start.
#GATE_MIN_PAPER_DAYS=3
#GATE_MIN_SIMULATED=30
#GATE_MIN_SIM_SUCCESS_RATE=0.3
#GATE_MICRO_MIN_TRADES=20
#GATE_MICRO_MIN_PROFITABLE_RATE=0.7

# --- Bills it must earn back each month (USD) ---------------------------
# Running on an Android phone (deploy/ANDROID.md) + free Helius RPC = $0.
# Add electricity if you want to be strict, e.g. server:0,rpc:0,power:1
MONTHLY_COSTS_USD=server:0,rpc:0
# Retire after this many months in a row of not covering the bills (0 = never)
SUSTAIN_STOP_AFTER_MONTHS=2

# --- Alerts (optional) --------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Brain ----------------------------------------------------------------
# Let it find extra busy, verified tokens by itself (on/off), up to MAX_TOKENS.
TOKEN_DISCOVERY=on
MAX_TOKENS=12
MIN_TOKEN_LIQUIDITY_USD=1000000
# Token safety: discovered tokens with fewer holders, a younger first pool, or
# more concentrated ownership are only watched. They never trade real money
# unless listed here (symbols or mints, comma-separated).
#MIN_TOKEN_HOLDERS=1000
#MIN_POOL_AGE_DAYS=7
#MAX_TOP_HOLDERS_PCT=60
LIVE_TOKENS=
# Event triggers: listen (over the RPC's WebSocket) to the pools the routes
# use, and re-quote a token the moment one changes. Capped so it can't flood
# the phone or the RPC plan; check data use with: npm run benchmark
#EVENT_TRIGGERS=on
#MAX_WATCHED_POOLS=4
#EVENT_DAILY_CAP=20000
#EVENT_DEBOUNCE_MS=1500
#BUSY_POOL_EVENTS_PER_MIN=30
# Only if your provider's WebSocket URL isn't the RPC URL with wss://
#RPC_WS_URL=
# Base time between scans. The brain goes faster near gaps / on sudden moves
# (focus scans of a single token, ~every 2s with a key), but never faster than
# Jupiter's request limit allows, and slows down if told "too many requests".
SCAN_INTERVAL_MS=5000
DATA_DIR=./data
