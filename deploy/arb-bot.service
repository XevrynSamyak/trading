[Unit]
Description=Solana arbitrage bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/trading
EnvironmentFile=/home/ubuntu/trading/.env
ExecStart=/home/ubuntu/trading/.venv/bin/python -m arbbot start
# Restart on crashes, but not after a deliberate halt (exit code 0) or a refused start (exit code 2).
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=30

[Install]
WantedBy=multi-user.target
